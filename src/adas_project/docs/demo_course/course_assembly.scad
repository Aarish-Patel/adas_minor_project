// Demo course assembly (generated by tools/demo_course_drawings.py) - mm, datum = start mark (car rear-axle centre),
// +x towards the end (brake) wall, +y away from the kerb wall, z up. Open in OpenSCAD; export STL / 3MF / DXF (projection).
wall_h = 300; wall_t = 20;
module post() { rotate_extrude($fn=72) polygon([[7.2, 0.0], [30.0, 0.0], [30.0, 2.0], [8.0, 2.0], [8.0, 240.0], [7.2, 240.0]]); }
module marker_start() { linear_extrude(1.2) polygon([[0, -12], [80, -12], [80, -25], [120, 0], [80, 25], [80, 12], [0, 12]]); }
module marker_goal() { linear_extrude(1.2) polygon([[-6, -30], [6, -30], [6, -6], [30, -6], [30, 6], [6, 6], [6, 30], [-6, 30], [-6, 6], [-30, 6], [-30, -6], [-6, -6]]); }
module marker_corner() { linear_extrude(1.2) polygon([[0, 0], [60, 0], [60, 12], [12, 12], [12, 60], [0, 60]]); }
module box(c, s) { translate([c[0] - s[0] / 2, c[1] - s[1] / 2, 0]) cube(s); }
color("Silver", 0.5) { translate([-1000.0, -1200.0 - wall_t, 0]) cube([5000.0, wall_t, wall_h]);   // W1 kerb wall
  translate([4000.0, -1200.0, 0]) cube([wall_t, 2400.0, wall_h]);                       // W2 end wall
  translate([-1000.0, 1200.0, 0]) cube([5000.0, wall_t, wall_h]);                       // W3 side wall
  translate([-1000.0 - wall_t, -1200.0, 0]) cube([wall_t, 2400.0, wall_h]); }            // W4 back wall
color("WhiteSmoke") translate([-1000.0, -1200.0, -5]) cube([5000.0, 2400.0, 5]);   // floor
color("BurlyWood") box([565.0, -1050.0], [330, 200, 250]);   // C1 parked car 1 (cardboard box)
color("BurlyWood") box([2395.0, -1050.0], [330, 200, 250]);   // C2 parked car 2 (cardboard box)
color("BurlyWood") box([1800.0, 450.0], [300, 300, 250]);   // O obstacle (cardboard box)
color("Black") box([3750.0, 1000.0], [250, 250, 250]);   // D dark box (optional)
color("RoyalBlue") translate([2000.0, 1050.0, 0]) post();   // T
color("SeaGreen") translate([0.0, 0.0, 0]) rotate([0, 0, 0]) marker_start();   // S
color("SeaGreen") translate([3000.0, 200.0, 0]) rotate([0, 0, 0]) marker_goal();   // G
color("SeaGreen") translate([100.0, -770.0, 0]) rotate([0, 0, -90]) marker_corner();   // L1
color("SeaGreen") translate([3100.0, -770.0, 0]) rotate([0, 0, 180]) marker_corner();   // L2
color("SeaGreen") translate([100.0, -1170.0, 0]) rotate([0, 0, 0]) marker_corner();   // L3
color("SeaGreen") translate([3100.0, -1170.0, 0]) rotate([0, 0, 90]) marker_corner();   // L4
%translate([-50.0, -100.0, 30]) cube([330.0, 200.0, 120]);   // the RC car on the start mark (reference only)
%translate([120.0, 0, 175.0]) cylinder(r=38, h=50, $fn=48);   // its LiDAR (scan plane z = 200)
