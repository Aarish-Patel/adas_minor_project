+        # never seen cost more, the driven trail less; an analytic shot to the goal crossing more than SHOT_UNKNOWN_M of unseen space
+        # is not taken (the search goes on through known space; plan_point_job falls back to no preference if that finds nothing)
+        self.terrain = None
+
+    SHOT_UNKNOWN_M = 0.3
+
+    def _terrain_cost(self, xy):
+        """Per-metre extra cost at points (N, 2) (0 outside the raster)."""
+        if self.terrain is None:
+            return np.zeros(len(xy))
+        x0, y0, res, c = self.terrain
+        i = ((np.asarray(xy)[:, 0] - x0) / res).astype(int)
+        j = ((np.asarray(xy)[:, 1] - y0) / res).astype(int)
+        ok = (i >= 0) & (i < c.shape[0]) & (j >= 0) & (j < c.shape[1])
+        out = np.zeros(len(i))
+        out[ok] = c[i[ok], j[ok]]
+        return out
 
