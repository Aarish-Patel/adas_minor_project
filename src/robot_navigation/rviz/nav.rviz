Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RobotModel1
        - /Camera1
        - /Odometry1
        - /Ultrasonics1
        - /Map1
        - /Path1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    # --- Global Options ---
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Value: Lines
      Normal Cell Count: 0
      Cell Size: 0.5
      Color: 100; 100; 100
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    # --- TF Frames ---
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0

    # --- Robot Model ---
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1.0

    # --- Camera Feed ---
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
      Transport Hint: raw

    # --- Odometry Arrow ---
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 100
      Shape:
        Value: Arrow
      Covariance:
        Value: false

    # --- Ultrasonic Sensor Range Displays ---
    - Class: rviz_default_plugins/Range
      Name: US_Front_Left
      Enabled: true
      Topic:
        Value: /ultrasonic_front_left
      Color: 255; 100; 0

    - Class: rviz_default_plugins/Range
      Name: US_Front_Center
      Enabled: true
      Topic:
        Value: /ultrasonic_front_center
      Color: 255; 50; 0

    - Class: rviz_default_plugins/Range
      Name: US_Front_Right
      Enabled: true
      Topic:
        Value: /ultrasonic_front_right
      Color: 255; 100; 0

    - Class: rviz_default_plugins/Range
      Name: US_Rear_Left
      Enabled: true
      Topic:
        Value: /ultrasonic_rear_left
      Color: 0; 100; 255

    - Class: rviz_default_plugins/Range
      Name: US_Rear_Right
      Enabled: true
      Topic:
        Value: /ultrasonic_rear_right
      Color: 0; 100; 255

    # --- Map ---
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false

    # --- Local Costmap ---
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap

    # --- Global Path ---
    - Class: rviz_default_plugins/Path
      Name: GlobalPath
      Enabled: true
      Topic:
        Value: /plan
      Color: 0; 255; 0
      Line Style:
        Value: Billboards
      Width: 0.03

    # --- Local Path ---
    - Class: rviz_default_plugins/Path
      Name: LocalPath
      Enabled: true
      Topic:
        Value: /local_plan
      Color: 255; 255; 0
      Line Style:
        Value: Billboards
      Width: 0.02

    # --- Nav2 Goal Tool Marker ---
    - Class: rviz_default_plugins/MarkerArray
      Name: GoalMarkers
      Enabled: true
      Topic:
        Value: /waypoints

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Value: true

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.5
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 50
  Y: 50
  Views:
    collapsed: false
  Camera:
    collapsed: false
